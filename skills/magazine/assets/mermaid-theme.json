{
  "theme": "base",
  "fontFamily": "\"Segoe UI\", \"Trebuchet MS\", system-ui, Arial, sans-serif",
  "themeVariables": {
    "darkMode": false,
    "fontFamily": "\"Segoe UI\", \"Trebuchet MS\", system-ui, Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "var(--accent-bg)",
    "primaryTextColor": "var(--ink)",
    "primaryBorderColor": "var(--accent)",
    "secondaryColor": "var(--green-bg)",
    "secondaryTextColor": "var(--ink)",
    "secondaryBorderColor": "var(--green)",
    "tertiaryColor": "var(--amber-bg)",
    "tertiaryTextColor": "var(--ink)",
    "tertiaryBorderColor": "var(--amber)",
    "mainBkg": "var(--accent-bg)",
    "nodeBorder": "var(--accent)",
    "nodeTextColor": "var(--ink)",
    "lineColor": "var(--ink-soft)",
    "textColor": "var(--ink)",
    "titleColor": "var(--ink)",
    "edgeLabelBackground": "var(--paper)",
    "clusterBkg": "var(--tint)",
    "clusterBorder": "var(--line)",
    "actorBkg": "var(--accent-bg)",
    "actorBorder": "var(--accent)",
    "actorTextColor": "var(--ink)",
    "actorLineColor": "var(--ink-faint)",
    "signalColor": "var(--ink)",
    "signalTextColor": "var(--ink)",
    "labelBoxBkgColor": "var(--amber-bg)",
    "labelBoxBorderColor": "var(--amber)",
    "labelTextColor": "var(--ink)",
    "loopTextColor": "var(--ink)",
    "noteBkgColor": "var(--amber-bg)",
    "noteBorderColor": "var(--amber)",
    "noteTextColor": "var(--ink)",
    "activationBkgColor": "var(--accent-bg)",
    "activationBorderColor": "var(--accent)",
    "sequenceNumberColor": "var(--paper)",
    "labelColor": "var(--ink)",
    "altBackground": "var(--tint)",
    "transitionColor": "var(--ink-soft)",
    "transitionLabelColor": "var(--ink)",
    "stateLabelColor": "var(--ink)",
    "stateBkg": "var(--accent-bg)",
    "compositeBackground": "var(--tint)",
    "compositeBorder": "var(--line)",
    "compositeTitleBackground": "var(--accent-bg)",
    "innerEndBackground": "var(--ink)",
    "specialStateColor": "var(--ink)",
    "pieOpacity": "1",
    "pieStrokeColor": "var(--paper)",
    "pieStrokeWidth": "2px",
    "pieOuterStrokeColor": "var(--paper)",
    "pieOuterStrokeWidth": "2px",
    "pieSectionTextColor": "var(--paper)",
    "pieSectionTextSize": "15px",
    "pieTitleTextColor": "var(--ink)",
    "pieTitleTextSize": "18px",
    "pieLegendTextColor": "var(--ink)",
    "pieLegendTextSize": "15px",
    "pie1": "var(--blue)",
    "pie2": "var(--green)",
    "pie3": "var(--amber)",
    "pie4": "var(--violet)",
    "pie5": "var(--red)",
    "pie6": "var(--teal)",
    "pie7": "var(--orange)",
    "pie8": "var(--ink-soft)",
    "pie9": "var(--blue-2)",
    "pie10": "var(--green-2)",
    "pie11": "var(--amber-2)",
    "pie12": "var(--violet-2)"
  },
  "flowchart": {
    "nodeSpacing": 16,
    "rankSpacing": 22,
    "padding": 8,
    "subGraphTitleMargin": { "top": 4, "bottom": 6 },
    "htmlLabels": false,
    "useMaxWidth": false
  },
  "sequence": {
    "useMaxWidth": false,
    "messageMargin": 28,
    "actorMargin": 40,
    "boxMargin": 8
  },
  "state": {
    "useMaxWidth": false
  }
}
